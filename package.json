{
  "name": "bidveil-midnight",
  "version": "1.0.0",
  "type": "module",
  "description": "Bidveil - A privacy-preserving sealed-bidding contract on Midnight Network",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "compile": "compact update 2>/dev/null || ~/.local/bin/compact update 2>/dev/null || true; compact compile contracts/bidveil.compact managed/bidveil || ~/.local/bin/compact compile contracts/bidveil.compact managed/bidveil",
    "test": "tsx --test tests/bidveil.test.ts",
    "test:all": "tsx --test tests/bidveil.test.ts tests/counter.test.ts",
    "deploy": "npx tsx src/deploy.ts",
    "network": "npx tsx src/network.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.18.0-rc.1",
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-provider": "npm:@midnight-ntwrk/midnight-js-indexer-public-data-provider@^4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@scure/bip39": "2.2.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
